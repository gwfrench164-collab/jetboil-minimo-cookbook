{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "field",
          "label",
          "target",
          "rationale",
          "origin_sha256",
          "target_sha256",
          "reviewed_on"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "origin_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
